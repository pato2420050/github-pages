<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flores Amarillas</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #fff8c6; /* Color amarillo claro */
        }

        .flower {
            position: absolute;
            width: 50px;
            height: 50px;
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/7/7c/Simple_yellow_flower.svg');
            background-size: cover;
            animation: float 10s linear infinite;
        }

        @keyframes float {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-10vh) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <script>
        function createFlower() {
            const flower = document.createElement("div");
            flower.classList.add("flower");
            document.body.appendChild(flower);

            const startPos = Math.random() * window.innerWidth;
            flower.style.left = `${startPos}px`;
            flower.style.animationDuration = `${5 + Math.random() * 5}s`;
            flower.style.width = `${30 + Math.random() * 30}px`;
            flower.style.height = flower.style.width;

            setTimeout(() => {
                flower.remove();
            }, 10000);
        }

        setInterval(createFlower, 500);
    </script>
</body>
</html>
